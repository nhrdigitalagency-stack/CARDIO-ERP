# APP_URL: URL publique de l'application (injectée automatiquement en production).
APP_URL="http://localhost:3000"

# SUPABASE (Base de données PostgreSQL relationnelle + Row Level Security)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CLOUDFLARE R2 (Stockage objet privé compatible S3 pour documents médicaux & logo)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optionnel : surcharge d'endpoint S3 (par défaut https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=

# RESEND (Notifications e-mail transactionnelles & relances automatiques)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Cabinet Cardiologie Paris 16 <onboarding@resend.dev>"

# WHATSAPP AUTOMATIQUE (Option 1 recommandée : Meta WhatsApp Cloud API | Option 2 gratuite : CallMeBot)
# WHATSAPP_PROVIDER=cloud_api | callmebot (détecté automatiquement si laissé vide)
WHATSAPP_PROVIDER=
WHATSAPP_DEFAULT_COUNTRY_CODE=237
# Option 1 : Meta WhatsApp Cloud API (envoi direct aux patients)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Optionnel : nom de modèle Meta approuvé pour les envois patients hors fenêtre 24h
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=fr
# Option 2 : CallMeBot (gratuit pour tests & alertes vers un numéro WhatsApp cabinet enregistré)
CALLMEBOT_API_KEY=
CALLMEBOT_PHONE=

# SÉCURITÉ & SESSIONS SERVEUR (min. 16 caractères recommandés en production)
SESSION_SECRET=
